# ── Python 字节码 / 缓存 ──
__pycache__/
*.pyc
*.pyo
*.pyd

# ── 打包产物 (PyInstaller) ──
dist/
build/
# NetPulse.spec 是打包配置, 必须入仓 (其他 *.spec 仍忽略)
*.spec
!NetPulse.spec

# ── 运行时生成的诊断报告 (输出目录, 由程序自动创建) ──
reports/

# ── 本地项目数据 (WorkBuddy, 含记忆/配置, 不入库) ──
.workbuddy/
.codefree/

# ── Ookla speedtest.exe 二进制 (运行时按需探测, 不入库) ──
speedtest/

# ── 操作系统 / 编辑器 ──
Thumbs.db
ehthumbs.db
.DS_Store
*.swp
.idea/
.vscode/

# ── 临时文件 ──
/commit_msg.txt
/_verify_*.py
/_smoke_*.py
/_perf_test*.py
/nul

# ── 报告优化改动留档 (一次性, 升级完就过期) ──
# 实际改动已合入 netpulse.py, 这些文件不入仓
/REPORT_REDESIGN_*.md
/report_redesign_*.html
/report_full_v2.*
.codegraph/
