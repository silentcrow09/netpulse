# ── Python 字节码 / 缓存 ──
__pycache__/
*.pyc
*.pyo
*.pyd

# ── 打包产物 (PyInstaller) ──
dist/
build/
# NetPulse.spec 是打包配置, 必须入仓 (其他 *.spec 仍忽略)
*.spec
!NetPulse.spec

# ── 运行时生成的诊断报告 (输出目录, 由程序自动创建) ──
reports/

# ── 本地项目数据 (WorkBuddy, 含记忆/配置, 不入库) ──
.workbuddy/
.codefree/

# ── Ookla speedtest.exe 二进制 (运行时按需探测, 不入库) ──
speedtest/

# ── 操作系统 / 编辑器 ──
Thumbs.db
ehthumbs.db
.DS_Store
*.swp
.idea/
.vscode/

# ── 临时文件 ──
/commit_msg.txt
/_verify_*.py
/_smoke_*.py
/_perf_test*.py
/nul

# ── 报告优化改动留档 (一次性, 升级完就过期) ──
# 实际改动已合入 netpulse.py, 这些文件不入仓
/REPORT_REDESIGN_*.md
/report_redesign_*.html
/report_full_v2.*
.codegraph/

# ── 测试入仓 (P0-01, v1.8.1): 脱敏 fixture 公开, 私有 fixture 本地忽略 ──
# tests/fixtures/windows/ 里的 MAC/IP/hostname/GUID 均为伪造值
# (02/06 本地管理 MAC, RFC 3849 文档 IPv6, DESKTOP-TEST01)
/tests/fixtures/private/

# ── 宣传视频工程 (v1.9.6): 只入仓脚本/HTML/文案源文件 (~365KB) ──
# 音视频产物与预览图 (wav/mp3/mp4/png, 共 ~72MB) 不入库;
# 注意: 目录级忽略会阻断白名单 negation, 故用 /* 逐层展开
/video_promo/*
!/video_promo/capture.mjs
!/video_promo/encode.sh
!/video_promo/narrate.py
!/video_promo/index.html
!/video_promo/poster-douyin.html
!/video_promo/poster-portrait.html
!/video_promo/album-cover.html
!/video_promo/douyin_copy_netpulse.md
!/video_promo/gsap.min.js
!/video_promo/fonts/
!/video_promo/narr1/
/video_promo/narr1/*
!/video_promo/narr1/narr_meta.json
!/video_promo/narr1/list.txt
